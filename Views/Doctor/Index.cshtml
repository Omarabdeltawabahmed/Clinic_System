@model IEnumerable<Clinic_System.Models.Appointment>

@{
    ViewData["Title"] = "Doctor Queue";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">👨‍⚕️ Doctor Dashboard</h3>
            <p class="text-muted small mb-0">Manage active patient consultations.</p>
        </div>
        <span class="badge bg-primary px-3 py-2 fs-6 rounded-pill">
            📅 @ViewBag.DisplayDateHeader
        </span>
    </div>

    <!-- Filter Card (Updated with Date Picker) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row align-items-end g-3">
                <!-- فلتر الطبيب -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted small mb-1">Filter by Doctor</label>
                    <select name="doctorId" class="form-select rounded-3" onchange="this.form.submit()">
                        <option value="">-- All Doctors --</option>
                        @if (ViewBag.Doctors != null)
                        {
                            var doctorsList = ViewBag.Doctors as IEnumerable<Clinic_System.Models.Doctor>;
                            if (doctorsList != null)
                            {
                                foreach (var doctor in doctorsList)
                                {
                                    <option value="@doctor.Id" selected="@(ViewBag.SelectedDoctorId != null && (int)ViewBag.SelectedDoctorId == doctor.Id)">
                                        Dr. @doctor.Name
                                    </option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- فلتر التاريخ الجديد (Date Filter) -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted small mb-1">Filter by Date</label>
                    <input type="date" name="filterDate" value="@ViewBag.SelectedDate" class="form-control rounded-3" onchange="this.form.submit()" />
                </div>

                <!-- زر إعادة التعيين -->
                <div class="col-md-4">
                    <a asp-action="Index" class="btn btn-secondary w-100 rounded-3">Reset Filter</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Queue Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold text-secondary mb-0">Patient Queue for @ViewBag.DisplayDateHeader</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Time</th>
                        <th>Patient Name</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <h5>No active patients in queue for this date.</h5>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-primary fw-bold">
                                    @item.AppointmentDate.ToString("hh:mm tt")
                                </td>
                                <td class="fw-bold">
                                    @(item.Patient != null ? item.Patient.Name : item.PatientName)
                                </td>
                                <td>
                                    @if (item.Status == Clinic_System.Models.AppointmentStatus.Waiting)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Waiting</span>
                                    }
                                    else if (item.Status == Clinic_System.Models.AppointmentStatus.InProgress)
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill">In Progress</span>
                                    }
                                    else if (item.Status == Clinic_System.Models.AppointmentStatus.Done)
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">Completed</span>
                                    }
                                    else if (item.Status == Clinic_System.Models.AppointmentStatus.NoShow)
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">Not Attend</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end align-items-center gap-2">

                                        <!-- 1. زر بدء الكشف Start -->
                                        <form asp-action="StartConsultation" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold">
                                                ▶ Start
                                            </button>
                                        </form>

                                        <!-- 2. زر السجل الطبي Medical Record -->
                                        <a asp-action="CreateRecord" asp-route-appointmentId="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                            📋 Medical Record
                                        </a>

                                        <!-- 3. زر لم يحضر Not Attend -->
                                        <form asp-action="MarkNoShow" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                                                ❌ Not Attend
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>