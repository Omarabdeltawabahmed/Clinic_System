@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-5 card p-4 shadow-sm bg-white rounded">
        <h2 class="text-center mb-4 text-primary fw-bold">CREATE ACCOUNT</h2>

        <form asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Confirm Password</label>
                <input type="password" name="confirmPassword" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 mt-2 fw-semibold">Register</button>

            <div class="mt-3 text-center">
                <p class="mb-0 text-muted">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold text-decoration-none">Login</a>
                </p>
            </div>
        </form>
    </div>
</div>