@model Clinic_System.Models.WorkingHour

@{
    ViewData["Title"] = "Add Working Schedule";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow rounded-4 overflow-hidden">

                <div class="card-body p-4 p-md-5">

                    <h3 class="fw-bold text-primary mb-1">Add Working Schedule</h3>
                    <p class="text-muted small mb-4">Assign doctor working days and operational hours.</p>

                    <form asp-action="Create">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="DoctorId" class="form-label fw-semibold"></label>
                            <select asp-for="DoctorId" class="form-select rounded-3" asp-items="ViewBag.DoctorId">
                                <option value="">-- Select Doctor --</option>
                            </select>
                            <span asp-validation-for="DoctorId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Day" class="form-label fw-semibold"></label>
                            <select asp-for="Day" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<Clinic_System.Models.DayOfWeek>()">
                                <option value="">-- Select Day --</option>
                            </select>
                            <span asp-validation-for="Day" class="text-danger small"></span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="StartTime" class="form-label fw-semibold"></label>
                                <input asp-for="StartTime" type="time" class="form-control rounded-3" />

                                <span asp-validation-for="StartTime" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="EndTime" class="form-label fw-semibold"></label>
                                <input asp-for="EndTime" type="time" class="form-control rounded-3" />

                                <span asp-validation-for="EndTime" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2">

                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Schedule</button>
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts 
{
    <partial name="_ValidationScriptsPartial" />
}