@model Clinic_System.Models.WorkingHour

@{
    ViewData["Title"] = "Delete Working Schedule";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card border-0 shadow rounded-4 overflow-hidden">

                <div class="card-body p-4 p-md-5 text-center">

                    <div class="text-danger mb-3">
                        <i class="bi bi-exclamation-circle-fill display-4"></i>
                    </div>

                    <h3 class="fw-bold text-dark mb-2">Remove Schedule</h3>
                    <p class="text-muted mb-4">Are you sure you want to delete this working schedule?</p>

                    <div class="bg-light p-3 rounded-3 text-start mb-4 small">
                        <div><strong>Doctor:</strong> @(Model.Doctor?.Name ?? "N/A")</div>
                        <div><strong>Day:</strong> @Model.Day</div>
                        <div><strong>Timing:</strong> @DateTime.Today.Add(Model.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(Model.EndTime).ToString("hh:mm tt")</div>
                    </div>

                    <form asp-action="Delete">

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-center gap-2">

                            <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">Confirm Delete</button>
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>