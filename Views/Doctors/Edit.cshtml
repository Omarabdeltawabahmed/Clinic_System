@model Clinic_System.Models.Doctor

@{
    ViewData["Title"] = "Edit Doctor";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">

                    <h3 class="fw-bold text-primary mb-1">Edit Doctor Details</h3>
                    <p class="text-muted small mb-4">Update information for Dr. @Model.Name</p>

                    <form asp-action="Edit" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="ProfilePictureUrl" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control rounded-3" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SpecialtyId" class="form-label fw-semibold"></label>
                            <select asp-for="SpecialtyId" class="form-select rounded-3" asp-items="ViewBag.SpecialtyId"></select>
                            <span asp-validation-for="SpecialtyId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Profile Picture</label>
                            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                            {
                                <div class="mb-3 d-flex align-items-center gap-3 bg-light p-2 rounded-3 border">
                                    <img src="@Model.ProfilePictureUrl" alt="@Model.Name" class="rounded-circle border shadow-sm" width="60" height="60" style="object-fit: cover;" />
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="checkbox" name="deleteImage" value="true" id="deleteImageCheck">
                                        <label class="form-check-label text-danger fw-semibold small" for="deleteImageCheck">
                                            Delete current picture
                                        </label>
                                    </div>
                                </div>
                            }
                            <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" />
                            <div class="form-text small text-muted">Upload a new picture to replace or leave empty to keep current.</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" type="email" class="form-control rounded-3" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label fw-semibold"></label>
                                <input asp-for="Phone" class="form-control rounded-3" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Salary" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Salary" type="number" step="0.01" class="form-control" />
                                </div>
                                <span asp-validation-for="Salary" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Fee" class="form-label fw-semibold">Consultation Fee</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Fee" type="number" step="0.01" class="form-control" />
                                </div>
                                <span asp-validation-for="Fee" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <button type="submit" class="btn btn-warning text-white rounded-pill px-4 shadow-sm">Update Changes</button>
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts 
{
    <partial name="_ValidationScriptsPartial" />
}