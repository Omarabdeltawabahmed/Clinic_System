@model Clinic_System.Models.Doctor

@{
    ViewData["Title"] = "Add New Doctor";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <h3 class="fw-bold text-primary mb-1">Add New Doctor</h3>
                    <p class="text-muted small mb-4">Enter professional details and assign a medical specialty.</p>

                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control rounded-3" placeholder="Dr. John Doe" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SpecialtyId" class="form-label fw-semibold"></label>
                            <select asp-for="SpecialtyId" class="form-select rounded-3" asp-items="ViewBag.SpecialtyId">
                                <option value="">-- Select Specialty --</option>
                            </select>
                            <span asp-validation-for="SpecialtyId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Profile Picture</label>
                            <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" type="email" class="form-control rounded-3"  />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Password -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Password</label>
                                <input type="password" name="password" class="form-control rounded-3"  required />
                            </div>

                        </div>

                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label fw-semibold"></label>
                                <input asp-for="Phone" class="form-control rounded-3" placeholder="+1234567890" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Salary" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Salary" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Salary" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Fee" class="form-label fw-semibold">Consultation Fee</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Fee" type="number" step="0.01" class="form-control"  />
                                </div>
                                <span asp-validation-for="Fee" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Doctor</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}