@model IEnumerable<Clinic_System.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container py-5" style="margin-top: 80px;">
    <div class="row mb-4">
        <div class="col-md-8 mx-auto text-center">
            <h2 class="fw-bold text-primary">Track My Appointments</h2>
            <p class="text-muted">Enter your name and phone number to view all your bookings</p>

            <!-- فورم البحث بالاسم ورقم التليفون -->
            <form asp-action="MyAppointments" method="get" class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                <div class="row g-3">
                    <div class="col-md-5">
                        <input type="text" name="patientName" value="@ViewBag.PatientName" class="form-control rounded-pill px-3 py-2" placeholder="Full Name..." required />
                    </div>
                    <div class="col-md-5">
                        <input type="text" name="phone" value="@ViewBag.SearchPhone" class="form-control rounded-pill px-3 py-2" placeholder="Phone Number..." required />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100 rounded-pill py-2" type="submit">Search</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="row mb-3">
            <div class="col-lg-10 mx-auto">
                <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-uppercase fs-7">
                                <tr>
                                    <th class="ps-4">Doctor</th>
                                    <th>Date & Time</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="ms-3">
                                                    <h6 class="mb-0 fw-bold">Dr. @item.Doctor?.Name</h6>
                                                    <small class="text-muted">@item.Doctor?.Specialty?.Name</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@item.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                            <small class="text-muted">@item.AppointmentDate.ToString("hh:mm tt")</small>
                                        </td>
                                        <td>
                                            @if (item.Status == AppointmentStatus.Waiting)
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Waiting</span>
                                            }
                                            else if (item.Status == AppointmentStatus.Done)
                                            {
                                                <span class="badge bg-success rounded-pill px-3 py-2">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger rounded-pill px-3 py-2">Cancelled</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            @if (item.Status == AppointmentStatus.Waiting)
                                            {
                                                <a asp-action="Cancel" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Are you sure you want to cancel this appointment?');">Cancel</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (ViewBag.SearchPhone != null)
    {
        <div class="row">
            <div class="col-md-6 mx-auto text-center">
                <div class="alert alert-warning rounded-4 p-4 shadow-sm">
                    <i class="bi bi-exclamation-circle fs-3 text-warning mb-2 d-block"></i>
                    <h5>No Appointments Found</h5>
                    <p class="text-muted mb-0">No records found matching name: <strong>@ViewBag.PatientName</strong> and phone: <strong>@ViewBag.SearchPhone</strong></p>
                </div>
            </div>
        </div>
    }
</div>