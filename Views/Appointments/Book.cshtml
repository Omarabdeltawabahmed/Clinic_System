@model Clinic_System.Models.Appointment

@{
    ViewData["Title"] = "Book Appointment";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">Book an Appointment</h2>
                    <p class="text-muted">Choose your preferred specialty, doctor, and time slot.</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Book" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Patient Name (أو PatientId لو مسجل دخول) -->
                    <div class="mb-3">
                        <label asp-for="PatientName" class="form-label fw-semibold">Your Name</label>
                        <input asp-for="PatientName" class="form-control rounded-pill px-3" placeholder="Enter your full name" />
                        <span asp-validation-for="PatientName" class="text-danger"></span>
                    </div>

                    <!-- Specialty Dropdown (Dynamic from DB) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Specialty</label>
                        <select id="specialtyDropdown" class="form-select rounded-pill px-3" asp-items="ViewBag.SpecialtyId">
                            <option value="">-- Select Specialty --</option>
                        </select>
                    </div>

                    <!-- Doctor Dropdown (Filtered via AJAX) -->
                    <div class="mb-3">
                        <label asp-for="DoctorId" class="form-label fw-semibold">Doctor</label>
                        <select asp-for="DoctorId" id="doctorDropdown" class="form-select rounded-pill px-3">
                            <option value="">-- Select Doctor --</option>
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger"></span>
                    </div>

                    <!-- Appointment Date -->
                    <div class="mb-3">
                        <label asp-for="AppointmentDate" class="form-label fw-semibold">Appointment Date</label>
                        <input asp-for="AppointmentDate" type="date" class="form-control rounded-pill px-3" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                    </div>

                    <!-- Appointment Time -->
                    <div class="mb-4">
                        <label asp-for="AppointmentTime" class="form-label fw-semibold">Appointment Time</label>
                        <input asp-for="AppointmentTime" type="time" class="form-control rounded-pill px-3" />
                        <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                    </div>

                    <!-- Patient Phone -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input type="text" name="PatientPhone" class="form-control rounded-pill px-3" placeholder="Enter your phone number" required />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary rounded-pill py-2 fw-bold shadow-sm">Confirm Booking</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#specialtyDropdown').change(function () {
                var specialtyId = $(this).val();
                var doctorDropdown = $('#doctorDropdown');

                doctorDropdown.empty();
                doctorDropdown.append('<option value="">-- Select Doctor --</option>');

                if (specialtyId) {
                    $.ajax({
                        url: '@Url.Action("GetDoctorsBySpecialty", "Appointments")',
                        type: 'GET',
                        data: { specialtyId: specialtyId },
                        success: function (data) {
                            $.each(data, function (index, doctor) {
                                doctorDropdown.append($('<option></option>').val(doctor.id).text(doctor.name));
                            });
                        },
                        error: function () {
                            alert('Failed to load doctors.');
                        }
                    });
                }
            });
        });
    </script>
}