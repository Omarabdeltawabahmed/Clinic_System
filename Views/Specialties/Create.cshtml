@model Clinic_System.Models.Specialty

@{
    ViewData["Title"] = "Add Specialty";
}

<div class="container my-5" style="max-width: 650px;">

    <div class="card border-0 shadow-sm rounded-4 p-4">

        <h3 class="fw-bold text-primary mb-3"><i class="bi bi-plus-circle me-2"></i>Add New Specialty</h3>

        <p class="text-muted mb-4">Enter the specialty details below.</p>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Specialty Name</label>
                <input asp-for="Name" class="form-control rounded-3" placeholder="e.g. Cardiology, Pediatrics" required />

                <span asp-validation-for="Name" class="text-danger"></span>
            </div>


            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Brief explanation of the specialty..."></textarea>
               
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IconPath" class="form-label fw-semibold">Select Specialty Icon</label>
                <select asp-for="IconPath" class="form-select rounded-3">
                    <option value="">-- Choose an Icon (Optional) --</option>
                    <option value="bi bi-heart-pulse-fill">❤️ Cardiology</option>
                    <option value="bi bi-eye-fill">👁️ Ophthalmology</option>
                    <option value="bi bi-person-arms-up">👶 Pediatrics</option>
                    <option value="bi bi-bandaid-fill">🩹 Dermatology / Surgery</option>
                    <option value="bi bi-capsule">💊 Internal Medicine</option>
                    <option value="bi bi-activity">📈 General Diagnosis / ICU</option>
                    <option value="bi bi-person-bounding-box">🧠 Neurology / Psychiatry</option>
                    <option value="bi bi-lungs-fill">🫁 Pulmonology</option>
                </select>
                <span asp-validation-for="IconPath" class="text-danger"></span>
            </div>


            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Save Specialty</button>
            </div>

        </form>

    </div>

</div>