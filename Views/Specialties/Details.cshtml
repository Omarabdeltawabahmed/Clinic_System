@model Clinic_System.Models.Specialty

@{
    ViewData["Title"] = "Specialty Details";
}

<div class="container my-5" style="max-width: 650px;">

    <div class="card border-0 shadow-sm rounded-4 p-4">

        <div class="d-flex align-items-center mb-4">

            <div class="bg-primary-subtle text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="@(string.IsNullOrEmpty(Model.IconPath) ? "bi bi-heart-pulse-fill fs-3" : Model.IconPath + " fs-3")"></i>
            </div>

            <div>
                <h3 class="fw-bold text-dark mb-0">@Model.Name</h3>
                <span class="badge bg-primary-subtle text-primary mt-1">Specialty ID: #@Model.Id</span>
            </div>

        </div>

        <div class="mb-4">

            <h6 class="fw-semibold text-muted">Description:</h6>
            <p class="fs-6 text-secondary bg-light p-3 rounded-3">
                @(string.IsNullOrEmpty(Model.Description) ? "No description provided for this specialty." : Model.Description)
            </p>

        </div>

        <div class="d-flex justify-content-between align-items-center pt-3 border-top">

            <a asp-action="Index" class="btn btn-light rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>

            <div class="d-flex gap-2">

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white rounded-pill px-4">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>

                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-4">
                    <i class="bi bi-trash me-1"></i> Delete
                </a>

            </div>

        </div>

    </div>

</div>