@model Clinic_System.Models.Specialty

@{
    ViewData["Title"] = "Delete Specialty";
}

<div class="container my-5" style="max-width: 550px;">

    <div class="card border-danger border-0 shadow-sm rounded-4 p-4">

        <div class="text-center mb-3">

            <i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>

            <h3 class="fw-bold text-danger mt-2">Delete Specialty?</h3>

            <p class="text-muted">Are you sure you want to delete this specialty? This action cannot be undone.</p>

        </div>

        <div class="bg-light p-3 rounded-3 mb-4">
            <h5 class="fw-bold mb-1">@Model.Name</h5>
            <p class="text-muted small mb-0">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
        </div>


        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex justify-content-center gap-2">
                <button type="submit" class="btn btn-danger rounded-pill px-4">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
            </div>

        </form>
    </div>
</div>