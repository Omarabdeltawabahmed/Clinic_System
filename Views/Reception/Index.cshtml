@model Clinic_System.ViewModels.ReceptionDashboardViewModel

@{
    ViewData["Title"] = "Reception Desk";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Reception Desk</h2>
            <p class="text-muted mb-0">Manage today's appointments, walk-in patients, and doctor queues.</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
        {
            <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#walkInModal">
                <i class="bi bi-person-plus-fill me-2"></i>New Walk-in Patient
            </button>
        }
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <!-- تغليف المدخلات داخل Form لإرسال الفلترة -->
            <form asp-action="Index" method="get">
                <div class="row align-items-end g-3">

                    <!-- Date Picker -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small mb-2">Select Date</label>
                        <input type="date"
                               name="date"
                               class="form-control rounded-3"
                               value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                               onchange="this.form.submit()" />
                    </div>

                    <!-- Doctor Dropdown -->
                    <div class="col-md-5">
                        <label class="form-label fw-semibold text-muted small mb-2">Filter by Doctor</label>
                        <select name="doctorId"
                                class="form-select rounded-3"
                                asp-items="ViewBag.DoctorsList"
                                onchange="this.form.submit()">
                            <option value="">-- All Doctors --</option>
                        </select>
                    </div>

                    <!-- Reset Button -->
                    <div class="col-md-3">
                        <a asp-action="Index" class="btn btn-secondary w-100 rounded-3 py-2 text-center text-decoration-none">
                            Reset Filters
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Appointments Table / Queue -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-list-check me-2 text-primary"></i>Today's Schedule</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Time</th>
                        <th>Patient Name</th>
                        <th>Phone</th>
                        <th>Doctor</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Appointments.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-event display-6 d-block mb-2 text-secondary"></i>
                                No appointments found for the selected date.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Appointments)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">
                                    <i class="bi bi-clock me-1"></i>@DateTime.Today.Add(item.Time).ToString("hh:mm tt")
                                </td>
                                <td class="fw-semibold">@item.PatientName</td>
                                <td><i class="bi bi-telephone me-1 text-muted"></i>@item.PatientPhone</td>
                                <td>@item.DoctorName <span class="badge bg-light text-dark border ms-1">@item.SpecialtyName</span></td>
                                <td class="text-center">
                                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-2">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (item.Status == Clinic_System.Models.AppointmentStatus.Waiting)
                                        {
                                            <form asp-action="ChangeStatus" method="post" class="d-inline">
                                                <input type="hidden" name="appointmentId" value="@item.Id" />
                                                <input type="hidden" name="newStatus" value="@Clinic_System.Models.AppointmentStatus.InProgress" />
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">Checked In</button>
                                            </form>

                                            <form asp-action="ChangeStatus" method="post" class="d-inline">
                                                <input type="hidden" name="appointmentId" value="@item.Id" />
                                                <input type="hidden" name="newStatus" value="@Clinic_System.Models.AppointmentStatus.Cancelled" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Cancel</button>
                                            </form>
                                        }
                                        else if (item.Status == Clinic_System.Models.AppointmentStatus.InProgress)
                                        {
                                            <span class="badge bg-info text-dark p-2 rounded-pill">In Doctor Queue</span>
                                        }
                                        else if (item.Status == Clinic_System.Models.AppointmentStatus.Done)
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill">Completed</span>
                                        }
                                        else if (item.Status == Clinic_System.Models.AppointmentStatus.Cancelled)
                                        {
                                            <span class="badge bg-light text-danger border border-danger p-2 rounded-pill">Cancelled</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Walk-in Patient Modal -->
<div class="modal fade" id="walkInModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary">New Walk-in Registration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="CreateWalkIn" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Patient Name</label>
                        <input type="text" name="PatientName" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input type="tel" name="PatientPhone" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Doctor</label>
                        <select name="DoctorId" class="form-select rounded-3" asp-items="ViewBag.DoctorsList" required>
                            <option value="">-- Choose Doctor --</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Appointment Time</label>
                        <input type="time" name="Time" class="form-control rounded-3" required />
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Confirm Booking</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>